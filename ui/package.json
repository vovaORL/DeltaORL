{
  "name": "delta-orl-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "app": "node -e \"const {spawn} = require('child_process'); delete process.env.ELECTRON_RUN_AS_NODE; const p = spawn(require('electron'), ['.'], {stdio: 'inherit', env: process.env}); p.on('exit', code => process.exit(code));\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node tests/run-smoke.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^45.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
